    <string name="dev_link_away">टीवी जवाब नहीं दे रहा। रिमोट खुला रहने तक ऐप अपने-आप फिर से कोशिश करता रहेगा।</string>
    <string name="dev_link_away_short">कोई जवाब नहीं</string>
    <string name="dev_link_debugging_off">टीवी ने कनेक्शन अस्वीकार कर दिया। जांचें कि USB डीबगिंग चालू है। Android TV 14 से कुछ टीवी सिर्फ़ वायरलेस डीबगिंग लेते हैं, जिसे TennaRC अभी इस्तेमाल नहीं कर सकता।</string>
    <string name="dev_link_debugging_off_short">टीवी पर डीबगिंग बंद है</string>
    <string name="dev_link_wireless">सिर्फ़ वायरलेस डीबगिंग चालू है, जिसे TennaRC अभी इस्तेमाल नहीं कर सकता। USB डीबगिंग भी चालू करें, या एक बार कंप्यूटर से पेयर करके adb tcpip 5555 चलाएं, जो टीवी के रीस्टार्ट होने तक काम करता है।</string>
    <string name="dev_link_wireless_short">सिर्फ़ वायरलेस डीबगिंग चालू है</string>
