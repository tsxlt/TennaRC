    <string name="dev_link_not_allowed_short">Nije dozvoljeno na televizoru</string>
    <string name="dev_link_forgotten">Televizor je zaboravio ovaj telefon, kao što Android TV radi sa telefonom koji nije video nedelju dana. Pokušaj ponovo i dozvoli vezu na televizoru.</string>
    <string name="dev_link_forgotten_short">Televizor je zaboravio ovaj telefon</string>
