    <string name="dev_link_title">חיבור למפתחים</string>
    <string name="dev_link_body">מציג את הקלטים של הטלוויזיה ואת כל האפליקציות שלה, מחליף קלט בטלוויזיות שמתעלמות ממקשי ה-HDMI, ובחלקן גם מכוון את הבהירות. החיבור עובר דרך ממשק ניפוי הבאגים של הטלוויזיה (ADB). המקשים וההקלדה עובדים אותו דבר גם בלעדיו.</string>
    <string name="dev_link_step_developer">בטלוויזיה יש לפתוח את הגדרות › מערכת › מידע כללי ולבחור שבע פעמים בגרסת ה-Build של Android TV OS. בטלוויזיות ישנות יותר זה העדפות המכשיר › מידע כללי › Build.</string>
    <string name="dev_link_step_debugging">יש לפתוח את אפשרויות למפתחים, ליד מידע כללי, ולהפעיל ניפוי באגים ב-USB. ב-Shield זה נקרא ניפוי באגים ברשת.</string>
    <string name="dev_link_step_allow">יש להקיש על התחברות, ואז בטלוויזיה לסמן את אפשר תמיד ולבחור אישור.</string>
    <string name="dev_link_connect">התחברות</string>
    <string name="dev_link_allow">יש לאשר בטלוויזיה</string>
    <string name="dev_link_allow_body">יש לסמן את אפשר תמיד ממחשב זה, ואז אישור</string>
    <string name="dev_link_turn_off">כיבוי</string>
    <string name="dev_link_off">כבוי. מוסיף קלטים ואת כל האפליקציות</string>
    <string name="dev_link_away">הטלוויזיה לא מגיבה. כל עוד השלט פתוח, החיבור ינסה שוב מעצמו.</string>
    <string name="dev_link_away_short">לא מגיבה</string>
    <string name="dev_link_debugging_off">הטלוויזיה דחתה את החיבור. יש לוודא שניפוי באגים ב-USB מופעל. החל מ-Android TV 14, חלק מהטלוויזיות מקבלות רק ניפוי באגים אלחוטי, ש-TennaRC עדיין לא תומכת בו.</string>
    <string name="dev_link_debugging_off_short">ניפוי הבאגים בטלוויזיה כבוי</string>
    <string name="dev_link_wireless">רק ניפוי באגים אלחוטי מופעל, ו-TennaRC עדיין לא תומכת בו. אפשר להפעיל גם ניפוי באגים ב-USB, או לבצע התאמה פעם אחת ממחשב ולהריץ adb tcpip 5555, שנשאר בתוקף עד שהטלוויזיה מופעלת מחדש.</string>
    <string name="dev_link_wireless_short">רק ניפוי באגים אלחוטי מופעל</string>
    <string name="dev_link_not_allowed">אף אחד לא אישר בטלוויזיה. אפשר לנסות שוב ולבחור שם אישור.</string>
    <string name="dev_link_not_allowed_short">לא אושר בטלוויזיה</string>
    <string name="dev_link_forgotten">הטלוויזיה שכחה את הטלפון הזה, כמו ש-Android TV עושה עם טלפון שלא ראתה שבוע. אפשר לנסות שוב ולאשר בטלוויזיה.</string>
