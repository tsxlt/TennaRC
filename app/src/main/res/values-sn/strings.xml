    <!-- Developer connection for ADB debugging -->
    <string name="dev_link_title">Kubatana kwevagadziri</string>
    <string name="dev_link_body">Inoratidza zvekupinza nemaapp ese eTV, inochinja chekupinza paTV dzisingateereri mabhatani e HDMI, uye inogadzirisa kupenya pane dzimwe. Inoshanda nekubatana kwe debugging (ADB) kweTV. Mabhatani nekunyora zvinoshanda zvakafanana pasina iko.</string>
    <string name="dev_link_step_developer">PaTV, vhura Settings › System › About wosarudza Android TV OS build kanomwe. PaTV dzekare i Device Preferences › About › Build.</string>
    <string name="dev_link_step_debugging">Vhura Developer options, padivi pe About, wobatidza USB debugging. Pa Shield i Network debugging.</string>
    <string name="dev_link_step_allow">Dzvanya Batanidza, wozomaka Always allow paTV wosarudza OK.</string>
    <string name="dev_link_connect">Batanidza</string>
    <string name="dev_link_allow">Bvumira paTV</string>
    <string name="dev_link_allow_body">Maka Always allow from this computer, wozoti OK</string>
    <string name="dev_link_turn_off">Dzima</string>
