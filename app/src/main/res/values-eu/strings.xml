    <string name="dev_link_title">Garatzaileen konexioa</string>
    <string name="dev_link_body">Telebistaren sarrerak eta aplikazio guztiak zerrendatzen ditu, sarrerak aldatzen ditu HDMI teklei kasurik egiten ez dieten telebistetan, eta distira doitzen du zenbaitetan. Telebistaren arazketa-konexioaren bidez dabil (ADB). Teklek eta idazketak berdin funtzionatzen dute hura gabe.</string>
    <string name="dev_link_step_developer">Telebistan, ireki Ezarpenak › Sistema › Honi buruz eta hautatu Android TV OS-aren konpilazioa zazpi aldiz. Telebista zaharragoetan: Device Preferences › About › Build.</string>
    <string name="dev_link_step_debugging">Ireki Garatzaileentzako aukerak (Honi buruz atalaren ondoan) eta aktibatu USB bidezko arazketa. Shield gailuetan, Network debugging da.</string>
    <string name="dev_link_step_allow">Sakatu Konektatu; gero, telebistan, markatu Baimendu beti eta aukeratu Ados.</string>
    <string name="dev_link_connect">Konektatu</string>
    <string name="dev_link_allow">Baimendu telebistan</string>
    <string name="dev_link_allow_body">Markatu Baimendu beti ordenagailu honetatik eta sakatu Ados</string>
    <string name="dev_link_turn_off">Desaktibatu</string>
    <string name="dev_link_off">Desaktibatuta. Sarrerak eta aplikazio guztiak gehitzen ditu</string>
    <string name="dev_link_away">Telebistak ez du erantzuten. Telekomandoa irekita dagoen bitartean, berriro saiatuko da bere kabuz.</string>
    <string name="dev_link_away_short">Ez du erantzuten</string>
    <string name="dev_link_debugging_off">Telebistak ukatu egin du. Egiaztatu USB bidezko arazketa aktibatuta dagoela. Android TV 14 bertsiotik, telebista batzuek hari gabeko arazketa soilik onartzen dute, eta TennaRC-k ezin du hori erabili oraindik.</string>
    <string name="dev_link_debugging_off_short">Arazketa desaktibatuta dago telebistan</string>
    <string name="dev_link_wireless">Hari gabeko arazketa soilik dago aktibatuta, eta TennaRC-k ezin du hori erabili oraindik. Aktibatu USB bidezko arazketa ere, edo parekatu ordenagailu batetik behin eta exekutatu adb tcpip 5555; telebista berrabiarazi arte iraungo du.</string>
    <string name="dev_link_wireless_short">Hari gabeko arazketa soilik dago aktibatuta</string>
    <string name="dev_link_not_allowed">Inork ez du baimendu telebistan. Saiatu berriro eta aukeratu Ados han.</string>
