    <!-- Developer connection for ADB debugging -->
    <string name="dev_link_title">Kulumikiza kwa okonza mapulogalamu</string>
    <string name="dev_link_body">Imaonetsa zolowetsa ndi mapulogalamu onse a TV, imasintha cholowetsa pa ma TV omwe sayankha mabatani a HDMI, ndipo imasintha kuwala pa ena. Imagwira ntchito kudzera mu kulumikiza kwa debugging (ADB) kwa TV. Mabatani ndi kulemba zimagwira ntchito chimodzimodzi popanda iyo.</string>
    <string name="dev_link_step_developer">Pa TV, tsegulani Settings › System › About ndipo sankhani Android TV OS build kasanu ndi kawiri. Pa ma TV akale ndi Device Preferences › About › Build.</string>
    <string name="dev_link_step_debugging">Tsegulani Developer options, pafupi ndi About, ndipo yatsani USB debugging. Pa Shield ndi Network debugging.</string>
    <string name="dev_link_step_allow">Dinani Lumikizani, kenako pa TV chongani Always allow ndipo sankhani OK.</string>
    <string name="dev_link_connect">Lumikizani</string>
    <string name="dev_link_allow">Lolani pa TV</string>
    <string name="dev_link_allow_body">Chongani Always allow from this computer, kenako OK</string>
    <string name="dev_link_turn_off">Zimitsani</string>
    <string name="dev_link_off">Yazimitsidwa. Imaonjezera zolowetsa ndi mapulogalamu onse</string>
    <string name="dev_link_away">TV sikuyankha. Pulogalamu imayesanso yokha pamene rimoti ili yotsegula.</string>
    <string name="dev_link_away_short">Sikuyankha</string>
    <string name="dev_link_debugging_off">TV yakana kulumikiza. Onetsetsani kuti USB debugging yayatsidwa. Kuyambira pa Android TV 14 ma TV ena amalandira Wireless debugging yokha, yomwe TennaRC siingagwiritse ntchito pakadali pano.</string>
    <string name="dev_link_debugging_off_short">Debugging yazimitsidwa pa TV</string>
    <string name="dev_link_wireless">Wireless debugging yokha ndi yomwe yayatsidwa, ndipo TennaRC siingaigwiritse ntchito pakadali pano. Yatsaninso USB debugging, kapena phatikizani kamodzi kuchokera pa kompyuta ndipo yendetsani adb tcpip 5555, zomwe zimakhalapo mpaka TV itayambiranso.</string>
    <string name="dev_link_wireless_short">Wireless debugging yokha ndi yomwe yayatsidwa</string>
    <string name="dev_link_not_allowed">Palibe amene walola pa TV. Yesaninso, ndipo sankhani OK pamenepo.</string>
    <string name="dev_link_not_allowed_short">Sizinaloledwe pa TV</string>
    <string name="dev_link_forgotten">TV yaiwala foni iyi, monga momwe Android TV imachitira ndi chipangizo chomwe sichinachione kwa sabata. Yesaninso, ndipo lolani pa TV.</string>
    <string name="dev_link_forgotten_short">TV yaiwala foni iyi</string>
