    <string name="dev_link_step_allow">Thepha u-Xhuma, bese ku-TV umaka i-Always allow futhi ukhethe u-OK.</string>
    <string name="dev_link_step_debugging">Vula i-Developer options, eduze ne-About, bese uvula i-USB debugging. Ku-Shield yi-Network debugging.</string>
