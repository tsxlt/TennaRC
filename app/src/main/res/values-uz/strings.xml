    <string name="dev_link_allow">Televizorda ruxsat bering</string>
    <string name="dev_link_allow_body">Shu kompyuterdan doim ruxsat berish belgilang, keyin OK</string>
    <string name="dev_link_away">Televizor javob bermayapti. Pult ochiq turganda ulanish avtomatik qayta urinib ko‘riladi.</string>
    <string name="dev_link_away_short">Javob bermayapti</string>
    <string name="dev_link_body">Televizorning o‘z kirishlari va barcha ilovalarini ko‘rsatadi, HDMI tugmalariga javob bermaydigan televizorlarda kirishni almashtiradi, ba’zilarida esa yorqinlikni sozlaydi. Televizorning nosozliklarni aniqlash ulanishi (ADB) orqali ishlaydi. Tugmalar va yozish usiz ham avvalgidek ishlaydi.</string>
    <string name="dev_link_connect">Ulanish</string>
    <string name="dev_link_debugging_off">Televizor ulanishni rad etdi. USB orqali nosozliklarni aniqlash yoqilganini tekshiring. Android TV 14 dan boshlab ba’zi televizorlar faqat simsiz nosozliklarni aniqlashni qabul qiladi, TennaRC esa undan hali foydalana olmaydi.</string>
    <string name="dev_link_debugging_off_short">Televizorda nosozliklarni aniqlash o‘chiq</string>
    <string name="dev_link_forgotten">Televizor bu telefonni unutdi: Android TV bir hafta ko‘rmagan qurilmalarni shunday unutadi. Qayta urinib ko‘ring va televizorda ruxsat bering.</string>
    <string name="dev_link_forgotten_short">Televizor bu telefonni unutdi</string>
    <string name="dev_link_not_allowed">Televizorda hech kim ruxsat bermadi. Qayta urinib ko‘ring va u yerda OK tanlang.</string>
    <string name="dev_link_not_allowed_short">Televizorda ruxsat berilmadi</string>
    <string name="dev_link_off">O‘chiq. Kirishlar va barcha ilovalarni qo‘shadi</string>
    <string name="dev_link_step_allow">Ulanish tugmasini bosing, keyin televizorda Doim ruxsat berish belgilang va OK tanlang.</string>
    <string name="dev_link_step_debugging">Qurilma haqida yonidagi Dasturchilar uchun sozlamalarni oching va USB orqali nosozliklarni aniqlashni yoqing. Shield qurilmasida bu Network debugging.</string>
    <string name="dev_link_step_developer">Televizorda Sozlamalar › Tizim › Qurilma haqida bo‘limini oching va Android TV OS build bandini yetti marta tanlang. Eski televizorlarda bu Device Preferences › About › Build.</string>
    <string name="dev_link_title">Dasturchi ulanishi</string>
    <string name="dev_link_turn_off">O‘chirish</string>
    <string name="dev_link_wireless">Faqat simsiz nosozliklarni aniqlash yoqilgan, TennaRC esa undan hali foydalana olmaydi. USB orqali nosozliklarni aniqlashni ham yoqing yoki kompyuterdan bir marta juftlab, adb tcpip 5555 buyrug‘ini bajaring; bu televizor qayta ishga tushguncha amal qiladi.</string>
    <string name="dev_link_wireless_short">Faqat simsiz nosozliklarni aniqlash yoqilgan</string>
